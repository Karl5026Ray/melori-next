# MELORI Music Platform — environment variables (per BUILD SPEC v1.1 Section 6)
# Copy to .env.local for local dev. NEVER commit .env.local. Set real values in Vercel UI.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Stripe (Phase 2 — use test keys for Preview/Development, live keys for Production)
# All OUTBOUND traffic (checkouts, customers, subscriptions, Connect) uses this
# one key. There is deliberately no legacy equivalent: nothing new may ever be
# created on the pre-cutover account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# TEMPORARY — 2026 account cutover. Signing secret of the PRE-CUTOVER Stripe
# account's webhook endpoint. When set, /api/members/stripe-webhook accepts
# events signed by either account, so subscriptions still billing on the old
# account keep their entitlements as they renew. Leave blank and behaviour is
# unchanged. DELETE this variable, and the legacy branch in
# src/app/api/members/stripe-webhook/route.ts, once the last legacy
# subscription has lapsed.
STRIPE_WEBHOOK_SECRET_LEGACY=

# App URL (Production: https://melorimusic.org ; Preview: https://<preview>.vercel.app)
NEXT_PUBLIC_APP_URL=

# PubNub (presence signaling + ephemeral room-vanish webhooks).
# publish/subscribe keys are safe to expose; SECRET key is server-only (PAM grants).
PUBNUB_PUBLISH_KEY=
PUBNUB_SUBSCRIBE_KEY=
PUBNUB_SECRET_KEY=
# Shared secret the PubNub Function forwards on the presence webhook so only
# PubNub can end rooms. Used as x-melori-webhook-secret or HMAC in x-melori-signature.
PUBNUB_WEBHOOK_SECRET=

# Cron secret (Vercel Cron -> /api/cron/mm-social-prune safety-net sweeps).
CRON_SECRET=
# ^ Any long random value. Every scheduled route in vercel.json rejects a call
# that does not present it, so an unset value silently disables room cleanup,
# presence reaping, and the email jobs rather than failing loudly.

# LiveKit (MM Social / Cinema / Concert live audio + video). Shared by every
# live-room format; Concert adds no LiveKit configuration of its own. Without
# these, /api/livekit-token cannot mint a join token and a live room sits on
# "Waiting for their camera" with no visible error. LIVEKIT_URL is the
# wss:// project URL from the LiveKit Cloud dashboard; the API secret is shown
# only once at key creation, so if it is lost, create a new key and update the
# key and secret together. Verify with: npm run verify:concert -- --live
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Calendar (Photography Phase 3 — two-way sync, server-side OAuth flow,
# SEPARATE from Supabase's existing Google sign-in). Calendar features return a
# clean 503 "not configured" until these are set; nothing else is affected.
# Set up: Google Cloud Console -> OAuth client (Web application) -> add
# authorized redirect URI https://melorimusic.org/api/studio/calendar/callback
# -> enable the Google Calendar API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=https://melorimusic.org/api/studio/calendar/callback
# Optional: base64-encoded 32-byte key to encrypt stored tokens at rest
# (AES-256-GCM, random IV per value). Without it, tokens are stored in
# plaintext and a console warning is logged once.
CALENDAR_TOKEN_KEY=
