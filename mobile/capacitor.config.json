{
  "appId": "org.melorimusic.app",
  "appName": "Melori Music",
  "webDir": "www",
  "appendUserAgent": "MeloriApp",
  "server": {
    "url": "https://melorimusic.org",
    "cleartext": false,
    "allowNavigation": [
      "melorimusic.org",
      "*.melorimusic.org",
      "*.supabase.co",
      "*.livekit.cloud",
      "*.pubnub.com"
    ]
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#111111",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#111111",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
