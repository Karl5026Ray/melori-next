{
  "name": "melori-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS and Android wrapper for Melori Music — loads the live melorimusic.org PWA in a Capacitor WebView.",
  "scripts": {
    "sync": "cap sync && npm run configure:native",
    "configure:native": "bash scripts/postsync.sh",
    "icon:ios": "bash scripts/install-ios-icon.sh",
    "icon:android": "bash scripts/configure-android.sh --icons-only",
    "configure:android": "bash scripts/configure-android.sh",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "add:ios": "cap add ios --packagemanager CocoaPods",
    "add:android": "cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
